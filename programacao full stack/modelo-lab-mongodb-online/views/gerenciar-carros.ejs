<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <title>Gerenciar Carros</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <div class="container">
        <h1>Gerência dos Carros</h1>

        <a class="botao" href="/cadastrar-carro">Cadastrar Novo Carro</a>

        <% if (carros.length === 0) { %>
            <p>Nenhum carro cadastrado ainda.</p>
        <% } %>

        <% carros.forEach(carro => { %>
            <div class="card">
                <h2><%= carro.marca %> <%= carro.modelo %></h2>
                <p>Ano: <%= carro.ano %></p>
                <p>Quantidade disponível: <%= carro.qtde_disponivel %></p>

                <% if (carro.qtde_disponivel == 0) { %>
                    <p class="esgotado">Esgotado</p>
                <% } %>

                <a class="botao" href="/editar-carro/<%= carro._id %>">Atualizar</a>

                <form action="/remover-carro/<%= carro._id %>" method="POST">
                    <button type="submit">Remover</button>
                </form>
            </div>
        <% }) %>

        <a class="botao" href="/carros">Ver Carros Disponíveis</a>
        <a class="botao" href="/projetos">Voltar</a>
    </div>
</body>
</html>
