<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <title>Blog</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>

    <h1>Blog</h1>

    <a href="/cadastrar_post">
        <button>Criar novo post</button>
    </a>

    <br><br>

    <% for (var i = 0; i < posts.length; i++) { %>

        <div class="post">
            <h2><%= posts[i].titulo %></h2>
            <h3><%= posts[i].resumo %></h3>
            <p><%= posts[i].conteudo %></p>
        </div>

    <% } %>

    <br>

    <a href="/">Voltar para projetos</a>

</body>
</html>